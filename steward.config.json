{
  "repo": "luplows/steward",
  "storyPrefix": "ST",
  "setup": { "command": "npm ci", "timeoutMinutes": 5 },
  "check": { "command": "npm run check", "timeoutMinutes": 10 },
  "landWhen": "all-checks",
  "land": true,
  "unitLinks": ["file"],
  "rulesFile": "REVIEW.md",
  "usageLimits": {
    "coder": { "session": 70, "weekly": 75 },
    "reviewer": { "session": 90, "weekly": 90 }
  }
}
